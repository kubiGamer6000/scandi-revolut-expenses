# --- Revolut Business API auth ---
#
# Two ways to authenticate:
#   (A) Long-running setup with auto-refresh (recommended for cron/servers)
#   (B) Quick paste-a-token setup (dev only — token expires every 40 minutes)

# Sandbox by default so you can't accidentally hit production.
#   Sandbox:    https://sandbox-b2b.revolut.com/api/1.0
#   Production: https://b2b.revolut.com/api/1.0
REVOLUT_BASE_URL=https://sandbox-b2b.revolut.com/api/1.0

# --- (A) Auto-refresh credentials ---

# ClientID shown in the Revolut Business app after you upload your certificate.
REVOLUT_CLIENT_ID=

# Path to the private key (PEM) that pairs with the public cert you uploaded.
# We sign the client-assertion JWT with this on every refresh.
# IMPORTANT: this file must NOT be committed. Keep it under .secrets/.
REVOLUT_PRIVATE_KEY_PATH=./.secrets/privatecert.pem

# Domain of the OAuth redirect URI you set in the Revolut dashboard.
# Must match the `iss` claim of the JWT. example.com is fine.
REVOLUT_JWT_ISSUER=example.com

# Initial refresh token from the auth-code exchange (`npm run auth:exchange`).
# Revolut rotates this on every refresh; we'll keep the latest one in the
# cache file below, so this env var is only used to seed the cache.
REVOLUT_REFRESH_TOKEN=

# Where to persist the rotating access_token + refresh_token between runs.
# Default works for local dev; on a server, point this to a stable path,
# e.g. /var/lib/scandi/revolut-tokens.json
REVOLUT_TOKEN_CACHE=./.secrets/token-cache.json

# --- (B) Manual override (skip auto-refresh) ---
# If set, we'll just send this Bearer token verbatim and never refresh.
# Useful for one-off testing. Get one from the developer portal.
# REVOLUT_ACCESS_TOKEN=

# --- Reporting ---
REPORT_OUT_DIR=./reports

# IANA time zone the report is anchored to. Period boundaries (--day, --week,
# --from, --to) and every displayed timestamp use this zone, so reports look
# the same whether you run them on your laptop or a server in Frankfurt.
# Default is Stockholm because that's where the Revolut Business account lives.
REPORT_TZ=Europe/Stockholm

# --- Smart-mode: LLM merchant categorization ---
# Required for `npm run report -- --smart`. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional: override paths for the merchants and FX caches.
# MERCHANTS_CACHE_PATH=./data/merchants.json
# FX_CACHE_PATH=./data/fx-cache.json

# In containers, set DATA_DIR once and the FX + merchants caches both land
# inside it. Mount this path as a persistent volume to keep caches warm
# across restarts (and, more importantly, to keep the Revolut refresh token
# cache below alive — see REVOLUT_TOKEN_CACHE).
# DATA_DIR=/data

# --- HTTP API server (`npm run serve`) ---

# One or more bearer keys. Whitespace- or comma-separated for rotation,
# e.g. "old-key new-key". Generate with:  openssl rand -hex 32
# The server refuses to start if this is empty — never run unauthenticated.
API_KEYS=

# Port the API listens on. DigitalOcean App Platform injects PORT
# automatically (overrides this). Defaults to 8080.
# PORT=8080
